# Copy required settings into the existing .env without overwriting its values.
# Standard OpenAI SDK name. Existing project key is named OPEN_AI_API_KEY;
# the application loader must support that alias without exposing its value.
OPENAI_API_KEY=

# Required for the Nimble API collector. OpenAI credentials cannot authenticate Nimble.
NIMBLE_API_KEY=

# Tinybird's RawTree is a separate product; do not reuse a Tinybird token.
# Read/write database scope is needed for memory events.
RAWTREE_API_KEY=

# Liquid runs locally via liquid/ without an API key.
# Optional future synthetic scenario generation:
BFL_API_KEY=
